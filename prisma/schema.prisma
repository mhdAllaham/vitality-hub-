// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  image         String?
  role          String    @default("USER")
  healthData    HealthData?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model HealthData {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight      Float?
  height      Float?
  age         Int?
  bmi         Float?
  bmiClass    String?
  updatedAt   DateTime @updatedAt
}

model HealthTip {
  id          String   @id @default(cuid())
  contentEn   String
  contentAr   String
  createdAt   DateTime @default(now())
}

model Exercise {
  id            String   @id @default(cuid())
  nameEn        String
  nameAr        String
  descriptionEn String
  descriptionAr String
  image         String?
  categoryEn    String?
  categoryAr    String?
  createdAt     DateTime @default(now())
}

model MealPlan {
  id            String   @id @default(cuid())
  type          String   // Breakfast, Lunch, Dinner
  nameEn        String
  nameAr        String
  descriptionEn String
  descriptionAr String
  image         String?
  createdAt     DateTime @default(now())
}

model HealthyFood {
  id          String   @id @default(cuid())
  categoryEn  String   // Fruits, Vegetables, Herbs
  categoryAr  String
  nameEn      String
  nameAr      String
  benefitsEn  String
  benefitsAr  String
  image       String?
  createdAt   DateTime @default(now())
}
